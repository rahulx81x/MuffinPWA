# Google OAuth (Web client) — required for multi-user sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorized redirect URI on the OAuth client
# Local (netlify dev): http://localhost:8888/.netlify/functions/auth-callback
# Production (muffin-ledger): https://muffin-ledger.netlify.app/.netlify/functions/auth-callback
GOOGLE_REDIRECT_URI=http://localhost:8888/.netlify/functions/auth-callback

# Long random secret for encrypting the session cookie (e.g. openssl rand -hex 32)
# Use the same value in Netlify Production after rotating.
SESSION_SECRET=

# Optional — only needed if you want local Blobs to hit your real Netlify site store
# instead of the free local filesystem fallback (.netlify/muffin-users/).
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
